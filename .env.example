# Copy to .env and adjust. All variables are optional; defaults are shown.

# Directory for uploaded files and the SQLite database.
DOCINSIGHT_DATA_DIR=data

# Maximum size of a single uploaded file, in megabytes.
DOCINSIGHT_MAX_UPLOAD_MB=20

# Maximum number of files accepted in one upload request.
DOCINSIGHT_MAX_FILES_PER_REQUEST=10

# Run OCR on scanned pages and images. Needs easyocr, which is only installed
# in the Docker image; locally scans end up as "failed".
DOCINSIGHT_OCR_ENABLED=false

# OCR languages (EasyOCR codes), as a JSON list.
DOCINSIGHT_OCR_LANGUAGES=["hr","en"]

# A PDF page with fewer non-whitespace characters than this goes through OCR.
DOCINSIGHT_OCR_MIN_CHARS=30

# Resolution used to render a PDF page into an image for OCR.
DOCINSIGHT_OCR_DPI=200
