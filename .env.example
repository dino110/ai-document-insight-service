# Copy to .env and adjust. All variables are optional; defaults are shown.

# Directory for uploaded files and the SQLite database.
DOCINSIGHT_DATA_DIR=data

# Maximum size of a single uploaded file, in megabytes.
DOCINSIGHT_MAX_UPLOAD_MB=20

# Maximum number of files accepted in one upload request.
DOCINSIGHT_MAX_FILES_PER_REQUEST=10

# Run OCR on scanned pages and images. Needs easyocr, which is only installed
# in the Docker image; locally scans end up as "failed".
DOCINSIGHT_OCR_ENABLED=false

# OCR languages (EasyOCR codes), as a JSON list.
DOCINSIGHT_OCR_LANGUAGES=["hr","en"]

# A PDF page with fewer non-whitespace characters than this goes through OCR.
DOCINSIGHT_OCR_MIN_CHARS=30

# Resolution used to render a PDF page into an image for OCR.
DOCINSIGHT_OCR_DPI=200

# --- RAG (phase 4) ---

# OpenAI API key, used for embeddings and answers. Never commit a real key.
# Without a key, indexing falls back to the local hashing embedder and /ask returns 503.
DOCINSIGHT_OPENAI_API_KEY=

# Embedding backend: auto (OpenAI if a key is set, else hashing), openai or hashing.
DOCINSIGHT_EMBEDDING_BACKEND=auto
DOCINSIGHT_EMBEDDING_MODEL=text-embedding-3-small
# Optional smaller vector size for OpenAI embeddings (e.g. 512); unset = full size.
# DOCINSIGHT_EMBEDDING_DIMENSIONS=512

# Chunk length and overlap, in characters (overlap must be smaller than size).
DOCINSIGHT_CHUNK_SIZE=800
DOCINSIGHT_CHUNK_OVERLAP=150

# How many chunks are passed to the LLM as context.
DOCINSIGHT_TOP_K=5

# Answer model, optional OpenAI-compatible server (e.g. Ollama) and timeout in seconds.
DOCINSIGHT_LLM_MODEL=gpt-6-luna
# Reasoning effort: none, low or medium (reasoning tokens are billed as output).
DOCINSIGHT_LLM_REASONING_EFFORT=low
# DOCINSIGHT_LLM_BASE_URL=http://localhost:11434/v1
DOCINSIGHT_LLM_TIMEOUT_S=30

# Document fields and summary (GET /documents/{id}/fields): most document text sent to the LLM.
DOCINSIGHT_FIELDS_MAX_CHARS=12000

# Retrieval: hybrid (embeddings + BM25 keyword match, finds invoice numbers and OIBs) or dense.
DOCINSIGHT_RETRIEVAL_MODE=hybrid

# --- NER (phase 5) ---

# Entities highlighted in answers: auto (spaCy models plus rules, rules only if the
# models are missing), spacy (fail at startup without the models) or rules.
DOCINSIGHT_NER_BACKEND=auto

# --- Rate limiting ---
# Requests per minute (0 = off). /ask and /fields share the LLM budget. Per session, plus one
# limit per client IP across all limited routes. Over a limit: 429 with Retry-After.
DOCINSIGHT_RATE_LIMIT_LLM_PER_MINUTE=20
DOCINSIGHT_RATE_LIMIT_UPLOAD_PER_MINUTE=10
DOCINSIGHT_RATE_LIMIT_IP_PER_MINUTE=100
